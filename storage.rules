rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /figma-uploads/{allPaths=**} {
      allow read, write;
    }
    match /audio-recordings/{allPaths=**} {
      allow read, write;
    }
    // Interview audio: only the owner can read/write
    match /interviews/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
